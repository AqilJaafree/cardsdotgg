# Copy to .env. Never commit .env or print these values.
# Deployer owns all contracts and funds the reserve. Needs testnet MON.
DEPLOYER_PRIVATE_KEY=
# Only this key can write RateOracle. Needs a little testnet MON.
KEEPER_PRIVATE_KEY=
# Testnet RPC, chain 10143.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_FALLBACK_URL=https://rpc.ankr.com/monad_testnet
# Mainnet RPC, chain 143, read by the one-shot keeper.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
# Verified mainnet sources are recorded in shared/rate-sources.json.
